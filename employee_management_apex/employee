public class EmployeeManager {

    public static void addEmployee(Integer empId, String name, String email, Date birthDate, String dept) {
        Employee__c emp = new Employee__c();
        emp.Emp_ID__c = empId;
        emp.Name = name;
        emp.Email__c = email;
        emp.Birth_Date__c = birthDate;
        emp.Department__c = dept;
        
        insert emp;
        System.debug('Employee Added Successfully');
    }

    public static void viewEmployees() {
        List<Employee__c> empList = [SELECT Id, Name, Emp_ID__c, Email__c, Birth_Date__c, Department__c FROM Employee__c];
        
        for(Employee__c e : empList) {
            System.debug('ID: ' + e.Emp_ID__c + 
                         ', Name: ' + e.Name + 
                         ', Email: ' + e.Email__c +
                         ', DOB: ' + e.Birth_Date__c +
                         ', Dept: ' + e.Department__c);
        }
    }

    public static void updateEmployee(Integer empId, String newDept) {
        Employee__c emp = [SELECT Id, Department__c FROM Employee__c WHERE Emp_ID__c = :empId LIMIT 1];
        emp.Department__c = newDept;
        update emp;
        System.debug('Employee Updated');
    }

    public static void deleteEmployee(Integer empId) {
        Employee__c emp = [SELECT Id FROM Employee__c WHERE Emp_ID__c = :empId LIMIT 1];
        delete emp;
        
        System.debug('Employee Deleted');
    }
}



