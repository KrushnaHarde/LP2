public class EmailController{
    public String toAddress {get; set;}
    public String subject {get; set;}
    public String body {get; set;}

    public boolean includeAttachment {get; set; }

    public Blob fileBody {get; set;}
    public String fileName {get; set;}

    public String msg {get; set;}

    public void SendEmail(){
        if(toAddress == null || !toAddress.contains('@')){
            msg = 'Invalid Email';
            return;
        }

        try{
            Messaging.SingleEmailMessage mail = new Messaging.SingleEmailMessage();

            mail.setToAddresses(new String[]{toAddress});
            mail.setSubject(subject);
            mail.setPlainTextBody(body);

            if(fileBody != null){
                Messaging.EmailFileAttachment attach = new Messaging.EmailFileAttachment();
                attach.setFileName(fileName);
                attach.setBody(fileBody);
                mail.setFileAttachments(new Messaging.EmailFileAttachment[]{attach});
            }

            Messaging.SendEmail(new Messaging.SingleEmailMessage[]{mail});

            msg = 'Email Sent';
        }catch(Exception e){
            msg = 'error : ' + e.getMessage();
        }
    }
}








<apex:page controller="EmailController">
    <apex:form enctype="multipart/form-data">
        <h2>Send Email</h2>
        Email : <apex:inputText value="{!toAddress}" /> <br/> <br/>
        Subject: <apex:inputText value="{!subject}" /> <br/> <br/>
        Body: <apex:inputTextarea value="{!body}" rows="4"/> <br/><br/>
        Attachment: <apex:inputFile value="{!fileBody}" fileName="{!fileName}" /> <br/><br/>
        <apex:commandButton value="Send Email" action="{!SendEmail}" /> <br/> <br/>

        <apex:outputText value="{!msg}" style="color:aqua; font-weight:bold;" />
    </apex:form>
</apex:page>
               